{
  "expo": {
    "name": "Sailors",
    "slug": "sailors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sailors",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/sailors.icon",
      "bundleIdentifier": "com.sailors.presentation",
      "appleTeamId": "MY2RYL82UV",
      "deploymentTarget": "17.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sailors.presentation",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/alan-sans/400Regular/AlanSans_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/krona-one/400Regular/KronaOne_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/amarna/100Thin/Amarna_100Thin.ttf",
            "../../node_modules/@expo-google-fonts/amarna/200ExtraLight/Amarna_200ExtraLight.ttf",
            "../../node_modules/@expo-google-fonts/amarna/300Light/Amarna_300Light.ttf",
            "../../node_modules/@expo-google-fonts/amarna/400Regular/Amarna_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/amarna/500Medium/Amarna_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/amarna/600SemiBold/Amarna_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/amarna/700Bold/Amarna_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/amarna/100Thin_Italic/Amarna_100Thin_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/200ExtraLight_Italic/Amarna_200ExtraLight_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/300Light_Italic/Amarna_300Light_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/400Regular_Italic/Amarna_400Regular_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/500Medium_Italic/Amarna_500Medium_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/600SemiBold_Italic/Amarna_600SemiBold_Italic.ttf",
            "../../node_modules/@expo-google-fonts/amarna/700Bold_Italic/Amarna_700Bold_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/200ExtraLight/Newsreader_200ExtraLight.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/300Light/Newsreader_300Light.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/700Bold/Newsreader_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/800ExtraBold/Newsreader_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/200ExtraLight_Italic/Newsreader_200ExtraLight_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/300Light_Italic/Newsreader_300Light_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/400Regular_Italic/Newsreader_400Regular_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/500Medium_Italic/Newsreader_500Medium_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/600SemiBold_Italic/Newsreader_600SemiBold_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/700Bold_Italic/Newsreader_700Bold_Italic.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/800ExtraBold_Italic/Newsreader_800ExtraBold_Italic.ttf",
            "../../node_modules/@expo-google-fonts/kalam/300Light/Kalam_300Light.ttf",
            "../../node_modules/@expo-google-fonts/kalam/400Regular/Kalam_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/kalam/700Bold/Kalam_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-router",
        {
          "root": "./app/routes"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-vector-icons/entypo",
      "@react-native-vector-icons/fontawesome6",
      "@react-native-vector-icons/lucide",
      "expo-audio",
      "@lottiefiles/dotlottie-react-native/plugins/withDotLottie",
      "expo-image",
      "expo-status-bar",
      "expo-sqlite",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "sailors",
          "organization": "sailors-j6"
        }
      ],
      "expo-notifications",
      [
        "./plugins/with-widget-fonts",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/kalam/400Regular/Kalam_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/amarna/400Regular/Amarna_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/alan-sans/400Regular/AlanSans_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/krona-one/400Regular/KronaOne_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.sailors.presentation",
          "widgets": [
            {
              "name": "TodaysPracticeWidget",
              "displayName": "Today's Practice",
              "description": "Your daily presentation-practice snippet",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StreakWidget",
              "displayName": "Practice Streak",
              "description": "Your daily practice streak",
              "ios": {
                "supportedFamilies": ["systemSmall"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "303236832902-rj0p6ii09h0p8r25ftp1i0krrdrqi238.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID": "303236832902-pv9mtnriam7ikifekvtcdkf6o708t89q.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.303236832902-pv9mtnriam7ikifekvtcdkf6o708t89q"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
