{
  "expo": {
    "name": "Sailor",
    "slug": "sailor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sailor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/sailor.icon",
      "bundleIdentifier": "com.sailor.presentation"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sailor.presentation"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app/routes"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "303236832902-rj0p6ii09h0p8r25ftp1i0krrdrqi238.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID": "303236832902-pv9mtnriam7ikifekvtcdkf6o708t89q.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.303236832902-pv9mtnriam7ikifekvtcdkf6o708t89q"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
