CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_KEY_HERE\n-----END PUBLIC KEY-----"
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://username:password@host:port/database_name
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx

# Redis — one DB for the Celery queue, a different DB index for results, to keep them isolated
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# MinIO
MINIO_ROOT_USER=username
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000

# Host:port a *phone* can reach MinIO on. Presigned URLs are signed against this
# — the signature covers the host, so leaving it empty hands the device a URL
# for localhost:9000, which resolves to the device itself and never downloads.
# Fine to leave empty for the iOS simulator; set it for a real device.
# MINIO_PUBLIC_ENDPOINT=192.168.1.42:9000
# MINIO_PUBLIC_SECURE=false

# ─── Subscription quota (RevenueCat) ───────────────────────────────────
# The *secret* key, which is not one of the public SDK keys the mobile app
# ships. This one can read any subscriber's entitlements, so it stays server
# side and never reaches a client bundle.
#
# To get it:
#   1. app.revenuecat.com → pick the project (the same one the app uses)
#   2. Project settings → API keys
#   3. "Secret API keys" section → + New  (or reveal an existing one)
#   4. V1 secret key is what this expects — it authenticates
#      GET https://api.revenuecat.com/v1/subscribers/{app_user_id}
#   5. Scope it read-only if the dashboard offers the choice; the backend only
#      ever reads entitlements
#
# Leave the value empty locally. Quota still enforces — it just trusts the tier already
# on the user row instead of confirming it against RevenueCat, which is what
# lets you promote yourself with one UPDATE instead of a sandbox purchase, and
# what lets the test suite run without a RevenueCat account.
#
# Set it in production. Nothing else writes users.subscription_tier (there is no
# RevenueCat webhook receiver — the only webhook is Clerk's), so without this key
# every user stays on the free tier forever and paying subscribers silently get
# free-tier limits.
REVENUECAT_API_KEY=sk_xxxxxxxxxxxx

# Must match PRO_ENTITLEMENT in apps/mobile/app/lib/purchases.ts. Case
# sensitive, and only meaningful if you renamed the entitlement in the
# dashboard — override on both sides or neither.
# REVENUECAT_ENTITLEMENT_ID=pro

# Generations per rolling 30 days, per tier. Env vars rather than constants
# because pricing changes shouldn't need a deploy.
# FREE_MONTHLY_GENERATIONS=3
# PRO_MONTHLY_GENERATIONS=100

# ─── AI provider ──────────────────────────────────────────────────────────────
# Which service generates scripts and cards. The prompts and the pipeline are
# provider-neutral; only the adapter under services/ai/providers/ differs.
#   ollama | anthropic | openai | gemini
AI_PROVIDER=ollama

# Primary model, and the one tried if it fails. Both are provider-specific — set
# them to match AI_PROVIDER (see the per-provider blocks below).
AI_MODEL=minimax-m3:cloud
AI_FALLBACK_MODEL=gemma4:31b-cloud

# "Answer, don't deliberate." Every call this app makes is heavily
# prompt-constrained — a fixed script skeleton, a per-beat role, an explicit word
# target, a JSON shape — so a reasoning pass mostly re-derives what the prompt
# already states, once per call across a dozen-odd calls. Each adapter maps this
# onto its provider's own knob (Ollama `think`, Anthropic/OpenAI effort).
# Set false to compare quality.
AI_FAST=true

# Ceiling on concurrent AI calls per worker process, across all tasks — the
# script fans out one call per beat, cards one per batch. A 429 is retried with
# backoff and the effective limit adapts downward on its own while the provider
# pushes back, so this is a maximum, not a fixed rate.
#
# Note it is per *process*: Celery's prefork pool gives each worker its own, so
# the real ceiling is this times your worker concurrency.
AI_MAX_CONCURRENCY=12

# ─── Provider credentials (only the selected one is needed) ───────────────────

# Ollama — ollama.com → Settings → API Keys
OLLAMA_API_KEY=<api_key>
# Defaults to https://ollama.com. Point at a local server to self-host.
# OLLAMA_HOST=http://localhost:11434

# Anthropic — platform.claude.com → API Keys
# With AI_PROVIDER=anthropic, set AI_MODEL to a Claude model id, e.g.
#   AI_MODEL=claude-opus-5
#   AI_FALLBACK_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Gemini — aistudio.google.com → Get API key
# With AI_PROVIDER=gemini, set AI_MODEL to a Gemini model id. The Flash line is
# the one to use here — this pipeline is a lot of short, tightly-constrained
# calls, which is exactly what it is priced and tuned for:
#   AI_MODEL=gemini-flash-latest
#   AI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=xxxxxxxxxxxx

# OpenAI, or anything speaking its chat-completions API. Set OPENAI_BASE_URL to
# reach Groq, Together, OpenRouter, or a local server without a new adapter.
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Superseded by AI_MODEL / AI_FALLBACK_MODEL. Still read when those are unset, so
# an older .env keeps working — prefer the AI_* names in new setups.
# OLLAMA_MODEL=minimax-m3:cloud
# OLLAMA_FALLBACK_MODEL=gemma4:31b-cloud
