{
  "name": "sailor-monorepo",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/backend"
  ],
  "scripts": {
    "postinstall": "cd apps/backend && uv sync",
    "dev": "turbo run dev celery --filter=sailor --filter=@sailor/backend",
    "run:backend": "turbo run dev celery --filter=@sailor/backend",
    "run:celery": "turbo run celery --filter=@sailor/backend",
    "dev:android": "turbo run android dev celery --filter=sailor --filter=@sailor/backend",
    "dev:ios": "turbo run ios dev celery --filter=sailor --filter=@sailor/backend",
    "ios": "turbo run ios",
    "android": "turbo run android",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.9.16"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18"
  }
}
