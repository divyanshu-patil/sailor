{
  "name": "sailors-monorepo",
  "private": true,
  "scripts": {
    "postinstall": "cd apps/backend && uv sync",
    "dev": "turbo run dev --filter=sailors --filter=@sailors/backend",
    "run:backend": "turbo run @sailors/backend#dev @sailors/backend#celery @sailors/backend#docker",
    "run:celery": "turbo run celery --filter=@sailors/backend",
    "dev:android": "turbo run sailors#android @sailors/backend#dev @sailors/backend#celery @sailors/backend#redis",
    "dev:ios": "turbo run sailors#ios @sailors/backend#dev @sailors/backend#celery @sailors/backend#docker",
    "db:update": "cd ./apps/backend && uv run alembic upgrade head && cd ../..",
    "quota": "cd ./apps/backend && uv run python -m scripts.quota",
    "ios": "turbo run ios",
    "android": "turbo run android",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "practice:regenerate": "pnpm --filter=@sailors/backend practice:regenerate",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.9.16"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=18"
  }
}
